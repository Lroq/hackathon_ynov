      "source": [
        "def to_text(ex):\n",
        "    q = str(ex[Q]).strip()\n",
        "    a = str(ex[A]).strip()\n",
        "    return {\"text\": f\"<|user|>\\n{q}<|end|>\\n<|assistant|>\\n{a}<|end|>\"}\n",
        "\n",
        "ds = ds.map(to_text, remove_columns=ds.column_names)\n",
        "ds = ds.train_test_split(test_size=0.05, seed=42)\n",
        "print(ds)\n",
        "print(\"\\n--- Exemple formaté ---\\n\", ds[\"train\"][0][\"text\"][:400])"
      ],
      "id": "nnMQTTDdyYM9"
